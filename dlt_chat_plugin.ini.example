# Chat Log Assistant - Configuration
# Place this file as dlt_chat_plugin.ini next to the plugin DLL
# or in the DLT Viewer config directory.

[Analyzer]
# Analyzer type: "rule-based" (default) or "llm"
type=rule-based

# LLM Configuration (used when type=llm or when using AI Query input)
# --- Ollama (local, open source) ---
llmEndpoint=http://localhost:11434/api/generate
llmApiKey=
llmModel=llama3.2:1b

# --- OpenAI ---
# llmEndpoint=https://api.openai.com/v1/chat/completions
# llmApiKey=sk-xxxxxxxxxxxxxxxxxxxx
# llmModel=gpt-3.5-turbo

# --- LocalAI ---
# llmEndpoint=http://localhost:8080/api/generate
# llmApiKey=
# llmModel=mistral

[Behavior]
maxResults=200
llmTimeout=30000
highlightColor=#FFE680

# Percorso file JSON con filtri utente (opzionale)
userFiltersPath=
