# Chat Log Assistant - Configuration
# Place this file as dlt_chat_plugin.ini next to the plugin DLL
# or in the DLT Viewer config directory.

[Analyzer]
# Analyzer type: "rule-based" (default) or "llm"
type=rule-based

# LLM Configuration (used when type=llm or when using AI Query input)
# --- Ollama (local, open source) ---
llmEndpoint=http://localhost:11434/api/generate
llmApiKey=
llmModel=llama3.2:1b

# --- OpenAI ---
# llmEndpoint=https://api.openai.com/v1/chat/completions
# llmApiKey=sk-xxxxxxxxxxxxxxxxxxxx
# llmModel=gpt-4o-mini

# --- LocalAI ---
# llmEndpoint=http://localhost:8080/v1/completions
# llmApiKey=
# llmModel=mistral

# --- GitHub Copilot ---
# llmEndpoint=https://api.githubcopilot.com/chat/completions
# llmApiKey=gho_xxxx  (or leave empty to use copilotOAuthToken below)
# llmModel=gpt-4o
# copilotOAuthToken=gho_xxxxxxxxxxxxxxxxxxxx

# LLM generation parameters (all optional, UI-editable)
llmMaxTokens=4096
llmTemperature=0.7
llmTimeout=120000

# Bulk analysis: classify all log entries via LLM on file load
bulkAnalysisEnabled=false

[Behavior]
maxResults=1000
highlightColor=#FFE680

# Path to user-defined JSON filter file (optional)
userFiltersPath=

[Filters]
# Path to a DLT-Viewer project/filter file (.dlp/.dlf) that drives the native
# Quick Actions. Leave empty to use the embedded default (MY_ARTIST8.dlp).
# The plugin maps each positive <pfilter> to a Quick Action, subtracts its paired
# negative filter, and highlights matches using the filter's own <filterColour>.
dlpPath=
